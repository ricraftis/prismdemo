# Copy to .env.local for local development, and set the same variables in Vercel → Settings → Environment Variables

# Loops (https://loops.so) — used by /api/subscribe and /api/contact
LOOPS_API_KEY=your_loops_api_key_here

# Required for diagnostic report emails (Survey → Loops transactional)
LOOPS_TRANSACTIONAL_ID=your_diagnostic_report_template_id

# Optional: auto-reply or notification when someone submits the Contact form
LOOPS_CONTACT_TRANSACTIONAL_ID=your_contact_form_template_id
